{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Satellite Setup",
  "version": "0.1.0",
  "identifier": "dev.emassey0135.satellite.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Satellite Setup",
        "width": 760,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Sets up Satellite on an Orbit Speak or Orbit Player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
